# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing real secrets.

# Public site URL — used for SEO metadata, sitemap, and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — the real, active backend for parent and teacher accounts,
# child profiles, teacher profiles, and applications (Prompt 110; see
# docs/AUTHENTICATION_BACKEND_AUDIT.md). Create a project at
# https://supabase.com for any other environment (e.g. a fresh clone, or a
# separate staging project) before filling these in. The anon key is safe
# for the browser — Row Level Security, not secrecy, is what protects each
# user's data. The service role key is server-only, must never be
# prefixed with NEXT_PUBLIC_, and is not required by anything in this
# codebase today (no server-side route currently needs to bypass RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin area (docs/ADMIN_ARCHITECTURE.md) — a real, minimal server-side gate
# for /admin, checked in src/proxy.ts. Both are server-only and must never
# be NEXT_PUBLIC_-prefixed. Without both set, /admin is blocked entirely
# (fails closed) rather than left open.
# ADMIN_PASSPHRASE: the shared passphrase an admin types in at /admin/login.
# ADMIN_SESSION_SECRET: a long random string used to sign the session
# cookie — generate one with `openssl rand -base64 32`, for example.
ADMIN_PASSPHRASE=
ADMIN_SESSION_SECRET=

# Google Search Console (docs/SEARCH_MONITORING_PLAN.md) — the verification
# code Search Console gives you when adding this property via its "HTML tag"
# method (Settings > Ownership verification). Renders a
# <meta name="google-site-verification"> tag on every page
# (src/app/layout.tsx) only when this is set; leaving it unset renders no
# tag at all, which is correct until a property is actually created. Public
# by nature (it's meant to be visible in a page's HTML), so NEXT_PUBLIC_ is
# correct here, unlike every other variable in this file.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Analytics (docs/SEARCH_MONITORING_PLAN.md) — a real id from whichever
# privacy-conscious analytics provider is chosen post-launch (Plausible,
# Fathom, and Vercel Analytics were all considered suitable; see that doc
# for the comparison). Generic name, not a specific vendor's own variable
# name, matching this file's existing convention for PAYMENT_PROVIDER_*
# below. Leaving this unset is correct today: it keeps
# isAnalyticsConfigured() (src/lib/analytics/is-configured.ts) false, which
# keeps trackEvent() (src/lib/analytics/track.ts) a genuine no-op — no
# analytics request is ever sent without this being deliberately set.
NEXT_PUBLIC_ANALYTICS_ID=

# Future payment provider (docs/PAYMENT_ARCHITECTURE.md) — no provider is
# connected today; leaving these unset is correct and keeps
# isPaymentProviderConfigured() (src/lib/payments/is-configured.ts) false,
# which is what keeps every future payment code path failing closed.
# Deliberately generic names, not a specific provider's own variable names
# (never STRIPE_SECRET_KEY or similar) — whichever real provider is chosen
# later fills these in without renaming anything. Both are server-only and
# must never be NEXT_PUBLIC_-prefixed.
# PAYMENT_PROVIDER_ID: the chosen provider's own identifier, once one exists.
# PAYMENT_PROVIDER_SECRET_KEY: that provider's server-only secret key.
PAYMENT_PROVIDER_ID=
PAYMENT_PROVIDER_SECRET_KEY=
